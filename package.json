{
  "name": "maison-mode-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "react:dev": "vite --config react-app/vite.config.js",
    "react:build": "vite build --config react-app/vite.config.js",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply maison-mode-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply maison-mode-db --remote",
    "smoke": "node scripts/smoke-test.mjs",
    "test:browser": "node scripts/react-browser-test.mjs",
    "postbuild": "node scripts/check-assets.mjs --delete"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "vite": "^8.2.2",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
