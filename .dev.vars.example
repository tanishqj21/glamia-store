SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_ADMIN_ENABLED=false
BREVO_API_KEY=replace-with-brevo-api-key
# Public GA4 web data-collection ID from Admin -> Data streams. This is not a secret.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional Google Analytics 4 admin dashboard integration. The service-account
# private key stays in Worker secrets and is never exposed to the browser.
GA4_PROPERTY_ID=replace-with-ga4-property-id
GA4_CLIENT_EMAIL=service-account-name@your-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n
