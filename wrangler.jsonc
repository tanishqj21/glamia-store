{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "maison-mode-commerce",
	"main": "src/index.js",
	"compatibility_date": "2026-08-26",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{"pattern": "glamiastore.com", "custom_domain": true},
		{"pattern": "www.glamiastore.com", "custom_domain": true},
		{"pattern": "wibrawl.glamiastore.com", "custom_domain": true}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "maison-mode-db",
			"database_id": "9f757277-5ef0-460b-ae8c-e6f52b9bc458",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "PRODUCT_IMAGES",
			"bucket_name": "maison-mode-product-images"
		},
		{
			"binding": "RETURN_DOCUMENTS",
			"bucket_name": "glamia-return-documents"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VEC",
			"index_name": "glamia-product-search",
			"remote": true
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"vars": {
		"GOOGLE_CLIENT_ID": "831595711865-ofo1b36f728opnm2h6rs7i2e9l0jrs3r.apps.googleusercontent.com",
		"GOOGLE_ANDROID_CLIENT_ID": "831595711865-mutldba04pp08m9p6s0mb18ud0i7pj5d.apps.googleusercontent.com,831595711865-lbhrva8k2kcp14a22m8e48as0akmv345.apps.googleusercontent.com",
		"APPLE_CLIENT_ID": "com.glamia.store",
		"GA4_MEASUREMENT_ID": "G-YB686J9CE4",
		"ADMIN_EMAILS": [
			"tanishqj29@gmail.com",
  			"glamia.apparels@gmail.com"
		],
		"BREVO_FROM_NAME": "Glamia",
		"BREVO_FROM_EMAIL": "support@glamiastore.com",
		"RAZORPAY_KEY_ID": "rzp_live_Td7I9Ih5JumPl1",
		"PHONEPE_ENV": "production",
		"PHONEPE_CLIENT_VERSION": "1",
		"GATEWAY_REFUNDS_ENABLED": "true",
		"AUTOMATIC_GATEWAY_REFUNDS_ENABLED": "true",
		"PUBLIC_SITE_URL": "https://glamiastore.com",
		"MERCHANT_ACCOUNT_ID": "5859812746",
		"MERCHANT_DATA_SOURCE_ID": "10750523846",
		"MERCHANT_DEVELOPER_EMAIL": "tanishqj29@gmail.com",
		"MERCHANT_USE_GA4_SERVICE_ACCOUNT": "true",
		"MERCHANT_SYNC_ENABLED": "true"
	}
}
